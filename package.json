{
  "name": "engacad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Engineering Academy (EngAcad) — a personal, browser-based SRE / DevOps / FDE training academy.",
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/python": "1.1.19",
    "codemirror": "6.0.2",
    "idb": "8.0.4",
    "lucide-react": "1.62.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
